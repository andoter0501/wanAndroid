  @Builder
  private contentPanel() {
    Row({ space: 8 }) {
      this.tabButton('æ”¶è—', MineTab.COLLECT)
      this.tabButton('æœªè¯»æ¶ˆæ¯', MineTab.UNREAD_MSG)
      this.tabButton('å·²è¯»æ¶ˆæ¯', MineTab.READ_MSG)
    }
    .width('100%')
    .padding({ left: 12, right: 12, top: 4, bottom: 8 })

    if (this.tab === MineTab.COLLECT) {
      this.collectListPanel()
    } else if (this.tab === MineTab.UNREAD_MSG) {
      this.messageListPanel('æœªè¯»æ¶ˆæ¯', this.messageVm.unreadState, true)
    } else {
      this.messageListPanel('å·²è¯»æ¶ˆæ¯', this.messageVm.readState, false)
