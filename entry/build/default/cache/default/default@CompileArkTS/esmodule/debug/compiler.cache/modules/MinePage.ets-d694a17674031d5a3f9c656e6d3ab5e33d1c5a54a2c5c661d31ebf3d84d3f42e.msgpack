          .padding(12)
          .backgroundColor(Color.White)
          .borderRadius(8)
        }
        }, (item: MessageItem) => item.id.toString())
    }
  }

  @Builder
  private tabButton(label: string, tab: MineTab) {
    Button(label)
      .type(this.tab === tab ? ButtonType.Capsule : ButtonType.Normal)
      .onClick(() => {
        this.tab = tab
      })
  }
}
