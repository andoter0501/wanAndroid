          Text(`ç§¯åˆ†ï¼š${this.authVm.userInfoState.data.coinInfo.coinCount}  ç­‰çº§ï¼š${this.authVm.userInfoState.data.coinInfo.level}  æ’åï¼š${this.authVm.userInfoState.data.coinInfo.rank}`)
            .fontSize(13)
