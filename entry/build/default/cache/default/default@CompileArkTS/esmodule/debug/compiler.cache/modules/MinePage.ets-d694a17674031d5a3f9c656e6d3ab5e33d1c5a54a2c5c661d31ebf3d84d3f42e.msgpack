      .padding(12)
      .margin({ left: 12, right: 12, top: 8, bottom: 8 })
    }
  }

  @Builder
  private statCell(value: string | number, label: string) {
    Column({ space: 2 }) {
      Text(`${value}`)
        .fontSize(22)
        .fontWeight(FontWeight.Bold)
        .fontColor(UiTheme.TEXT_PRIMARY)
      Text(label)
        .fontSize(12)
        .fontColor(UiTheme.TEXT_SECONDARY)
    }
    .layoutWeight(1)
