    }, Text);
    Text.pop();
    Column.pop();
}
function DefaultError(message, onRetry, parent = null) {
    (parent ? parent : this).observeComponentCreation2((elmtId, isInitialRender) => {
        Column.create();
        Column.width('100%');
        Column.padding(20);
